# Cloudflare Pages headers (Vite copies public/ into the deploy root).

/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# Vite emits content-hashed JS/CSS/WASM — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Models are NOT hashed (stable names so artists can drop in replacements) — revalidate.
/models/*
  Cache-Control: public, max-age=0, must-revalidate
